# Rust
pipewire_audio_router/bridge-daemon/target/
# Container-extracted binary from scripts/build-daemon.sh
pipewire_audio_router/bridge-daemon/dist/

# Python
__pycache__/
*.pyc
.pytest_cache/

# ESPHome
firmware/bt-bridge/.esphome/
firmware/bt-bridge/secrets.yaml

# Secrets: the key-bearing announce-asset generator (contains a GEMINI_API key).
# The keyless generate.sh is tracked; regenerate assets locally with this one.
pipewire_audio_router/bridge-daemon/assets/generate_with_key.sh

# Editor/OS cruft
.DS_Store
*.swp

# Vendored path-dep crates: keep their sources, never their build output.
pipewire_audio_router/bridge-daemon/vendor/*/target/

# Agent worktrees (created by tooling, never committed)
.claude/
