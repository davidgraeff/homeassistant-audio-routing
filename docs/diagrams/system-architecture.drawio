<mxfile host="Electron">
  <diagram name="System Architecture" id="sysarch1">
    <mxGraphModel dx="2358" dy="1680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="System overview — three independently-installable components. The add-on is a blackbox here; its internals live in pipewire_audio_router/docs/architecture.md (+ the airplay-in-to-voicepe-and-ap2 diagram)." style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="1660" height="24" as="geometry" />
        </mxCell>

        <!-- ===================== SOURCES ===================== -->
        <mxCell id="src_airplay" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Phone / PC / Mac&#xa;(AirPlay sender)" vertex="1">
          <mxGeometry height="56" width="200" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="src_phone_bt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Phone&#xa;(Bluetooth A2DP source)" vertex="1">
          <mxGeometry height="56" width="200" x="40" y="240" as="geometry" />
        </mxCell>
        <mxCell id="bt_bridge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Bluetooth bridge box&#xa;A2DP sink → RTP. Two variants:&#xa;• ESP32-D0WDQ6 ESPHome firmware&#xa;• Raspberry Pi (BlueZ+PipeWire, no fw)&#xa;(firmware/bt-bridge · firmware/pi-bridge)" vertex="1">
          <mxGeometry height="110" width="250" x="300" y="212" as="geometry" />
        </mxCell>

        <!-- ===================== ADD-ON BLACKBOX ===================== -->
        <mxCell id="container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;spacingTop=6;arcSize=3;" value="PipeWire Audio Router add-on (Ubuntu 26.04 LTS) — the router" vertex="1">
          <mxGeometry height="430" width="440" x="620" y="70" as="geometry" />
        </mxCell>
        <mxCell id="daemon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Bridge daemon (Rust) + PipeWire / WirePlumber&#xa;&#xa;pipewire-rs registry observer + native links / volume / announce.&#xa;All in-process: AirPlay receiver · RTP source · AirPlay-2 senders&#xa;+ PTP grandmaster · Sendspin servers.&#xa;axum REST + WebSocket API on :8099" vertex="1">
          <mxGeometry height="170" width="400" x="640" y="110" as="geometry" />
        </mxCell>
        <mxCell id="pw_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="PipeWire + WirePlumber graph&#xa;many-to-many routing / mixing — one steady anchor per group,&#xa;only the sender split per device (Sendspin + AirPlay-2 backends)" vertex="1">
          <mxGeometry height="70" width="400" x="640" y="292" as="geometry" />
        </mxCell>
        <mxCell id="detail_ptr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontStyle=2;align=left;spacingLeft=8;" value="Internal audio flow (anchor → per-device Sendspin + AirPlay-2 senders,&#xa;the two clocks / PTP, the real-time thread ladder):&#xa;→ see diagram &quot;airplay-in-to-voicepe-and-ap2&quot; + architecture.md" vertex="1">
          <mxGeometry height="80" width="400" x="640" y="378" as="geometry" />
        </mxCell>

        <!-- ===================== OUTPUTS ===================== -->
        <mxCell id="out_avr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="AV receiver&#xa;(Yamaha / Pioneer)&#xa;AirPlay-2 (replaces RAOP)" vertex="1">
          <mxGeometry height="64" width="210" x="1120" y="150" as="geometry" />
        </mxCell>
        <mxCell id="out_espspeaker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="ESPHome speaker / HA Voice PE&#xa;(Sendspin client)" vertex="1">
          <mxGeometry height="64" width="210" x="1120" y="300" as="geometry" />
        </mxCell>

        <!-- ===================== HOME ASSISTANT ===================== -->
        <mxCell id="ha_group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;spacingTop=6;" value="Home Assistant" vertex="1">
          <mxGeometry height="400" width="300" x="1400" y="80" as="geometry" />
        </mxCell>
        <mxCell id="browser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Browser&#xa;(manual routing UI, GET /)" vertex="1">
          <mxGeometry height="56" width="260" x="1420" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ha_automations" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Voice assistant / automations&#xa;(tts.speak, play_media)" vertex="1">
          <mxGeometry height="64" width="260" x="1420" y="210" as="geometry" />
        </mxCell>
        <mxCell id="ha_integration" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="custom_components/pipewire_audio_router&#xa;(media_player entities)" vertex="1">
          <mxGeometry height="64" width="260" x="1420" y="330" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES ===================== -->
        <mxCell id="e1" edge="1" parent="1" source="src_airplay" target="daemon" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" value="AirPlay receive (RTSP/RTP)">
          <mxGeometry relative="1" y="-10" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="src_phone_bt" target="bt_bridge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="classic BT A2DP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="bt_bridge" target="daemon" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" value="RTP / UDP">
          <mxGeometry relative="1" y="10" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="pw_note" target="out_avr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" value="AirPlay-2 (RTP/ALAC + PTP)">
          <mxGeometry relative="1" y="-10" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="pw_note" target="out_espspeaker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" value="Sendspin (WebSocket)">
          <mxGeometry relative="1" y="10" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="ha_integration" target="daemon" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.6;" value="REST: /api/media_players, /volume, /announce">
          <mxGeometry relative="1" x="0.2" y="20" as="geometry">
            <mxPoint as="offset" />
            <Array as="points"><mxPoint x="1360" y="362" /><mxPoint x="1360" y="212" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="browser" target="daemon" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.2;" value="HTTP + WebSocket (routing UI)">
          <mxGeometry relative="1" x="0.2" y="-14" as="geometry">
            <mxPoint as="offset" />
            <Array as="points"><mxPoint x="1370" y="138" /><mxPoint x="1370" y="144" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="ha_automations" target="ha_integration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
