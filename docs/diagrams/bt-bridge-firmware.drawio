<mxfile host="app.diagrams.net">
  <diagram name="BT Bridge Firmware" id="btbridge1">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="phone" value="Phone / PC&#10;(A2DP source)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="esp32" value="ESP32-D0WDQ6 firmware (firmware/bt-bridge) — ESPHome + custom classic-BT a2dp_bridge component" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="700" height="500" as="geometry" />
        </mxCell>

        <mxCell id="bt_radio" value="Classic BT radio (Bluedroid)&#10;A2DP sink + AVRCP controller&#10;GAP pairing (SSP &quot;Just Works&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="rtp_encoder" value="RTP encoder + UDP socket&#10;(send_rtp_packet_, S16LE&#10;native-endian, fixed SSRC&#10;per boot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="90" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="avrcp_poll" value="AVRCP metadata poll&#10;(every 5s, title + artist)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ha_entities" value="HA entities&#10;binary_sensor Connected&#10;text_sensor Name / Address&#10;text_sensor Title / Artist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="620" y="230" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="esphome_core" value="ESPHome core&#10;WiFi + captive portal, OTA,&#10;native API — zero BLE involved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ha_config" value="text/number entities&#10;RTP host / port&#10;(restore_value: true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="620" y="360" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ha" value="Home Assistant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1080" y="290" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="rtp_source" value="PipeWire rtp-source&#10;(add-on container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1080" y="90" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="classic BT A2DP&#10;pairing + stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="phone" target="bt_radio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="PCM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="bt_radio" target="rtp_encoder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="RTP / UDP :46000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rtp_encoder" target="rtp_source">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bt_radio" target="avrcp_poll">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="connection state + metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="avrcp_poll" target="ha_entities">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="publishes via native API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.8;" edge="1" parent="1" source="esphome_core" target="ha_entities">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="native API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="ha_entities" target="ha">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="user sets RTP target" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.7;entryX=1;entryY=0.5;" edge="1" parent="1" source="ha" target="ha_config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="set_rtp_host / set_rtp_port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=1;entryY=0.7;" edge="1" parent="1" source="ha_config" target="rtp_encoder">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="395" />
              <mxPoint x="960" y="153" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
