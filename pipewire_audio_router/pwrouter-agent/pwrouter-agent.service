[Unit]
# systemd **user** unit, not a system one: the agent controls the audio of one
# logged-in session (docs/receiver-agent-plan.md §13.2), so it must run as that
# user and inherit their PipeWire socket via XDG_RUNTIME_DIR.
Description=PipeWire audio router — receiver agent
Documentation=https://github.com/davidgraeff/homeassistant-pipewire-audio-routing
# PipeWire is a user service too; ordering after it avoids a pointless first
# connection failure (the agent would retry anyway).
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/pwrouter-agent run
# The agent restores the host's volumes on SIGTERM, so give it a moment to do so
# rather than killing it mid-restore.
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=always
RestartSec=5
# Nothing here needs elevated anything: no ports are opened, no files outside the
# user's own config are written.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/pwrouter-agent
PrivateTmp=yes

[Install]
WantedBy=default.target
