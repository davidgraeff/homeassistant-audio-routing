[Unit]
# systemd **user** unit, not a system one: the agent controls the audio of one
# logged-in session (docs/receiver-agent-plan.md §13.2), so it must run as that
# user and inherit their PipeWire socket via XDG_RUNTIME_DIR.
Description=PipeWire audio router — receiver agent
Documentation=https://github.com/davidgraeff/homeassistant-pipewire-audio-routing
# PipeWire is a user service too; ordering after it avoids a pointless first
# connection failure (the agent would retry anyway).
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/pwrouter-agent run
# The agent restores the host's volumes on SIGTERM, so give it a moment to do so
# rather than killing it mid-restore.
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=always
RestartSec=5
# Nothing here needs elevated anything: no ports are opened, no files outside the
# user's own config are written.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# ConfigurationDirectory=, *not* ReadWritePaths=: with ProtectHome=read-only the
# config dir has to be writable, but ReadWritePaths= requires the path to already
# exist at namespace-setup time and the agent only creates it when a pairing is
# saved — so a fresh install died with 226/NAMESPACE before it ever ran.
# ConfigurationDirectory= creates $XDG_CONFIG_HOME/pwrouter-agent (i.e.
# ~/.config/pwrouter-agent for a user unit) up front and binds it read-write.
ConfigurationDirectory=pwrouter-agent
# The dir holds a bearer token (the file itself is 0600); no reason for anyone
# else to even list it.
ConfigurationDirectoryMode=0700
# So the agent can install and remove *this file*: the autostart switch in its tray
# menu writes (or deletes) ~/.config/systemd/user/pwrouter-agent.service, which
# ProtectHome=read-only would otherwise refuse. The `-` prefix makes a missing path
# non-fatal, which matters for a unit started from anywhere but here — without it a
# host with no ~/.config/systemd/user dies with 226/NAMESPACE before it ever runs.
ReadWritePaths=-%h/.config/systemd/user
PrivateTmp=yes

[Install]
WantedBy=default.target
