<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram id="graph-offload" name="Graph-offload comparison">
    <mxGraphModel dx="2000" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Offloading audio work to the PipeWire graph — TODAY (after M1/M4)  vs  PROPOSED (O-B: audio math in-graph)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend:  🟩 PipeWire graph (RT thread, graph clock — jitter-free vs the app runtime)   🟧 Rust async (tokio runtime)   🟦 Rust RT egress thread (SCHED_FIFO)   🟨 hand-rolled buffer   🟪 receiver   ⬜ removed" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="2000" height="20" as="geometry" />
        </mxCell>

        <!-- divider -->
        <mxCell id="divider" style="endArrow=none;html=1;strokeColor=#999999;dashed=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1245" y="90" as="sourcePoint" />
            <mxPoint x="1245" y="1060" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============================= LEFT: TODAY ============================= -->
        <mxCell id="lhdr" value="TODAY — after M1/M4  ·  audio math split between the Rust process and the graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1100" height="34" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="shairplay: RTP/RTSP recv + decrypt + ALAC/AAC decode&#10;[tokio worker]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="140" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="HAND-ROLLED RING  (Mutex + VecDeque, f32)&#10;150 ms prebuffer / 40 ms re-arm  ·  clock reconciliation done in Rust" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="214" width="360" height="66" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="airplay-producer stream callback&#10;[dedicated OS thread · NON-RT · own mainloop clock]&#10;→ &quot;airplay-in&quot; node (F32LE 44.1 kHz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="300" width="420" height="66" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="&quot;airplay-in&quot; producer node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="384" width="420" height="38" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="ANCHOR null-sink: MIX inputs + resample 44.1→48 kHz&#10;[graph RT thread · graph clock]  — one shared anchor for the whole group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="440" width="420" height="58" as="geometry" />
        </mxCell>
        <mxCell id="l6" value="anchor MONITOR ports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="516" width="420" height="34" as="geometry" />
        </mxCell>
        <mxCell id="l7" value="sendspin-capture stream callback&#10;[dedicated OS thread · RT_PROCESS · graph-clock paced]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="568" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="l8" value="sendspin-relay  [dedicated SCHED_FIFO thread]  (M1)&#10;stamp(shared timeline)  +  OVERLAY-MIX / DUCK in Rust  +  fan-out&#10;one PCM feed differentiated per-device inside the Rust process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="638" width="420" height="72" as="geometry" />
        </mxCell>
        <mxCell id="l9" value="per-device WebSocket writers  [tokio tasks]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="726" width="420" height="38" as="geometry" />
        </mxCell>
        <mxCell id="l10" value="ESPHome / Voice PE receivers  ·  250 ms lead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="782" width="420" height="40" as="geometry" />
        </mxCell>

        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="l6" target="l7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="l7" target="l8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="l8" target="l9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;dashed=1;" edge="1" parent="1" source="l9" target="l10"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- left annotations -->
        <mxCell id="lnote1" value="Rust re-implements clock reconciliation (RC2/RC3) that the graph already does natively." style="text;html=1;align=left;fontSize=11;fontColor=#b85450;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="222" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lnote2" value="Mixing / ducking / overlay + per-device differentiation happen in the Rust process, not the graph." style="text;html=1;align=left;fontSize=11;fontColor=#b85450;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="646" width="360" height="56" as="geometry" />
        </mxCell>

        <!-- ============================= RIGHT: PROPOSED ============================= -->
        <mxCell id="rhdr" value="PROPOSED — per-device PipeWire nodes (O-B) + adaptive rate-match  ·  the graph does the audio math" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1290" y="80" width="1150" height="34" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="shairplay: RTP/RTSP recv + decrypt + ALAC/AAC decode&#10;[tokio worker]  — unchanged (codec work, irreducible)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="140" width="440" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&quot;airplay-in&quot; stream WITH PipeWire ADAPTIVE RESAMPLER + RATE_MATCH&#10;[graph RT] — the graph's DLL rate-matcher reconciles the source clock to&#10;the graph clock; PipeWire owns the (managed) jitter buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="212" width="440" height="72" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="graph routing: source → per-device sink nodes&#10;[graph RT · native links]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="304" width="440" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="PER-DEVICE sink node (O-B)&#10;+ per-device VOLUME node (duck)  + announcement source LINKED IN (overlay)&#10;→ the node itself MIXES.  Routing + volume + duck + overlay all NATIVE.&#10;[graph RT thread · graph clock]&#10;(NEW part = moving the mix into the graph; per-device senders + duck already exist)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="376" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="per-device node MONITOR ports  [graph RT · graph-clock paced]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="484" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="THIN Rust egress per device  [SCHED_FIFO thread]&#10;capture (graph-paced) → stamp(shared timeline) → WebSocket send&#10;NO mixing / ducking / clock-reconciliation in Rust anymore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="544" width="440" height="72" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="ESPHome / Voice PE receivers  ·  250 ms lead&#10;(sync still via shared-timeline stamps — unchanged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="636" width="440" height="50" as="geometry" />
        </mxCell>

        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;" edge="1" parent="1" source="r5" target="r6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333;dashed=1;" edge="1" parent="1" source="r6" target="r7"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- right badges -->
        <mxCell id="rb2" value="⟵ DELETED: hand-rolled ring + producer mainloop clock (airplay_source.rs).&#10;RC2 (re-prebuffer) &amp; RC3 (drift) solved NATIVELY, not patched — PipeWire's&#10;adaptive resampler tracks the source clock with a DLL. A network jitter buffer&#10;still exists, but PipeWire manages it on the graph clock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2020" y="204" width="420" height="88" as="geometry" />
        </mxCell>
        <mxCell id="rb4" value="⟵ DELETED: overlay_mixer.rs + the in-relay per-device mix.&#10;Duck = a volume node; announcement = a source linked into the node;&#10;mix = the sink summing its inputs. Per-device volume becomes node Props&#10;(exactly like RAOP today). This is O-B / O-E in&#10;architecture-limitations-and-options.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2020" y="372" width="420" height="98" as="geometry" />
        </mxCell>
        <mxCell id="rb6" value="⟵ The relay collapses to a thin, graph-paced egress:&#10;capture → stamp → send. Nothing to preempt but the socket write." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2020" y="546" width="420" height="66" as="geometry" />
        </mxCell>

        <!-- ============================= STATUS CORRECTION (right panel) ============================= -->
        <mxCell id="already_done" value="ALREADY IMPLEMENTED — validated on hardware (spike-results-and-status.md):  ✓ per-device senders on a shared timeline (S1/S2)   ✓ per-device volume (sendspin_volume.rs)   ✓ per-device duck / announcement overlay (overlay_mixer.rs — in Rust)   ✓ one per-device PipeWire node end-to-end (S3).&#10;So the DEFAULT music path ALREADY splits a per-device sender per device — but fed from ONE steady anchor monitor, with the mix/duck still done in Rust. What this PROPOSED panel adds is only: (a) graph-native mixing (delete overlay_mixer), and (b) ingest adaptive rate-match." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="720" width="1150" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s3_caveat" value="⚠ HARDWARE FINDING that constrains this offload (S3): a STANDALONE per-device null-sink is NOT a steady clock driver — it produced ~1 audio glitch / 60 s (QUANT 0), while the one-anchor-monitor path showed zero downstream xruns. The team's conclusion was the OPPOSITE of naive per-device nodes: &quot;feed a sync group from ONE anchor monitor, split only the sender.&quot;&#10;⇒ Graph-native per-device mixing must use a STEADY-DRIVER node (e.g. a per-device volume / loopback chain hung off the steady anchor), NOT an independent null-sink per device. Also: per-device/anchor links must be PERSISTED &amp; reconciled (a source-node rename silenced the anchor in the spike)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="884" width="1150" height="166" as="geometry" />
        </mxCell>

        <!-- ============================= BOTTOM SUMMARY ============================= -->
        <mxCell id="sum_into" value="MOVES INTO THE GRAPH  (RT thread, graph clock — inherently jitter-free vs the app runtime):&#10;• source-clock reconciliation + resampling  → PipeWire adaptive resampler / RATE_MATCH&#10;• routing  → native links&#10;• per-device volume + ducking  → volume node / node Props&#10;• announcement overlay + mixing  → summing at the device sink" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1090" width="780" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sum_del" value="DELETED FROM THE RUST PROCESS:&#10;• the hand-rolled ingest ring + separate producer mainloop clock (airplay_source.rs)&#10;• overlay_mixer.rs&#10;• the per-device mix inside the sendspin relay&#10;&#10;Less hand-rolled audio DSP + fewer app-runtime clocks = fewer places jitter can enter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="1090" width="740" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sum_stay" value="STAYS IN RUST  (irreducible — not graph operations):&#10;• ALAC / AAC decode on ingest (codec)&#10;• sendspin shared-timeline STAMPING + WebSocket transport&#10;• AP2 RTP / ALAC / PTP egress&#10;&#10;PipeWire has no WebSocket/sendspin clock domain, so the protocol egress can't live&#10;in the graph. (A native WS sink module = O-C, considered &amp; rejected: maintenance cost.)&#10;Multi-room sync still needs the Rust timeline stamp — the graph doesn't carry it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1620" y="1090" width="820" height="150" as="geometry" />
        </mxCell>

        <mxCell id="tradeoff" value="TRADE-OFFS:  + each per-device node is RT-paced &amp; jitter-free (vs one shared anchor differentiated in Rust);  + per-device duck/announce/route without touching groupmates (fixes L1/L2/L5 in the arch doc).   − more graph nodes ⇒ more graph CPU on the Pi (one sink + volume node per device);  − a per-device capture per device instead of one anchor capture;  − O-B needs a real node-per-sendspin-device (the strategic mechanism target — not yet built).   Sequencing: land it AFTER the M1/M4 RT fixes are measured on hardware." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1256" width="2380" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
